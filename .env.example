# ---------------------------------------------------------------------------
# Mal for Snoat sitt lokale miljø.
#
# Ikke kopier denne filen manuelt – kjør `node scripts/bootstrap-env.mjs`.
# Scriptet genererer unike hemmeligheter og signerer ANON_KEY/SERVICE_ROLE_KEY
# med det genererte JWT_SECRET. Kopierte demo-nøkler ville gitt alle
# installasjoner de samme hemmelighetene.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=snoat

# Absolutt sti, må være identisk på host og i backend-containeren.
SNOAT_WORKSPACE_DIR=/absolutt/sti/til/snoat/.snoat/workspaces

# Host-stien til Docker-socketen. Docker Desktop på macOS bruker ofte
# ~/.docker/run/docker.sock i stedet for standardstien.
DOCKER_SOCKET_PATH=/var/run/docker.sock

SNOAT_ROOT_DOMAIN=snoat.localhost
SNOAT_APP_DOMAIN_SUFFIX=.snoat.localhost

# IP-en kundene peker sitt eget domene mot med en A-record. Vises i DNS-fanen i
# prosjektvisningen, og må være den offentlige IP-en Caddy lytter på.
SNOAT_SERVER_IP=127.0.0.1

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=

JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=

SITE_URL=http://snoat.localhost
ADDITIONAL_REDIRECT_URLS=http://localhost:3000,http://snoat.localhost
API_EXTERNAL_URL=http://supabase.snoat.localhost
SUPABASE_PUBLIC_URL=http://supabase.snoat.localhost

DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# Må stå false i produksjon – se CONTEXT_FOR_AI/08_security_model.md.
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false

# --- Resend (SMTP) ----------------------------------------------------------
# Brukernavn er alltid "resend"; passordet er API-nøkkelen.
# Avsenderdomenet må verifiseres på https://resend.com/domains.
RESEND_API_KEY=
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_ADMIN_EMAIL=noreply@snoat.com
SMTP_SENDER_NAME=Snoat

# GitHub OAuth – https://github.com/settings/developers
# Authorization callback URL: http://supabase.snoat.localhost/auth/v1/callback
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

REALTIME_ENC_KEY=
REALTIME_SECRET_KEY_BASE=

BACKEND_PORT=3100
CADDY_ADMIN_URL=http://caddy:2019
SNOAT_APPS_NETWORK=snoat_apps
SNOAT_FRONTEND_ORIGIN=http://localhost:8080
LOG_LEVEL=info

# Ressurstak per deployet applikasjon. SNOAT_APP_PORT injiseres som PORT i
# containeren – applikasjonen må lytte på den for at Caddy skal nå den.
SNOAT_APP_PORT=3000
SNOAT_APP_MEMORY_MB=512
SNOAT_APP_CPUS=1
SNOAT_BUILD_TIMEOUT_MS=1800000

# Hvor mange prosjekter som kan bygges samtidig på hele verten. En nix-build tar
# det minnet den trenger, og to samtidige på en liten VPS tar ned Postgres og
# Caddy sammen med seg. Hev først når verten har minne å avse.
SNOAT_MAX_CONCURRENT_BUILDS=1

# Heap-tak for Node under bygging (MB). Uten dette er det verten som setter
# grensen. Ca. 75 % av minnet du kan avse til én build.
SNOAT_BUILD_NODE_MEMORY_MB=1536

# Statiske sider serveres av Caddy rett fra disk, uten container. Stien monteres
# i både backend (skriv) og caddy (les), så den må endres begge steder samtidig
# – docker-compose bruker denne variabelen til begge.
SNOAT_SITES_DIR=/srv/sites
# Hvor mange tidligere versjoner av hver statiske side som beholdes på disk.
SNOAT_STATIC_KEEP_VERSIONS=3

# Node-versjonen prosjekter bygges med når repoet ikke oppgir en selv (verken
# engines.node, .nvmrc eller .node-version). Nixpacks sin egen standard er 18,
# som er ute av vedlikehold og ikke bygger moderne Next.js eller Vite.
SNOAT_DEFAULT_NODE_VERSION=22
